        "cam": {
          "description": "az_deg, el_deg, fov_deg, mode(0 eo,1 ir)",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "fx": {
          "description": "per active effector: effector idx, track idx",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "t",
        "e",
        "tr",
        "cam",
        "fx"
      ],
      "title": "ReplayFrame",
      "type": "object"
