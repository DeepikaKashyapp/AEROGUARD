        "hostile": {
          "type": "boolean"
        },
        "size_m": {
          "type": "number"
        },
        "cruise_mps": {
          "type": "number"
        },
        "terminal_mps": {
          "default": 0,
          "type": "number"
        },
        "alt_m": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
