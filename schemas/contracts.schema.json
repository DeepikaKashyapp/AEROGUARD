        "rounds_per_shot": {
          "default": 1,
          "type": "integer"
        },
        "sector_half_deg": {
          "default": 0,
          "type": "number"
        },
        "duration_s": {
          "default": 0,
          "type": "number"
        },
        "exposure_s": {
          "default": 0,
          "type": "number"
        },
        "dwell_s": {
          "default": 0,
          "type": "number"
        },
        "slew_s": {
          "default": 1,
          "type": "number"
        },
        "speed_mps": {
          "default": 0,
          "type": "number"
        },
        "blast_m": {
          "default": 0,
          "type": "number"
        },
        "pk": {
          "default": 0,
          "type": "number"
        },
        "cycle_s": {
          "default": 0,
          "type": "number"
        },
        "needs_los": {
          "default": true,
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
