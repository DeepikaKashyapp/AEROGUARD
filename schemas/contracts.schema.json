      "type": "object"
    },
    "Label": {
      "description": "What the trainee can call a track (Classify step).",
      "enum": [
        "bird",
        "friendly",
        "civil",
        "recon",
        "fpv",
        "loitering",
        "decoy",
        "unknown"
      ],
