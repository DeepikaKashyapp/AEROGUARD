        "rcs_m2": {
          "type": "number"
        },
        "thermal": {
          "description": "IR brightness 0..1",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "acoustic_db": {
          "type": "number"
        },
        "link": {
          "$ref": "#/$defs/ControlLink"
        },
        "nav": {
          "$ref": "#/$defs/Nav"
        },
        "rf_band": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
