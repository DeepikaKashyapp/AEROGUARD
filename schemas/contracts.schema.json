        "name",
        "label",
        "hostile",
        "size_m",
        "cruise_mps",
        "terminal_mps",
        "alt_m",
        "rcs_m2",
        "thermal",
        "acoustic_db",
        "link",
        "nav",
        "rf_band",
        "iff",
        "cost_inr",
        "damage",
        "source",
        "illustrative"
