          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
        },
        "friendly_flights": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FriendlyFlight"
