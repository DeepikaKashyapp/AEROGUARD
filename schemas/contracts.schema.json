      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "pos": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
        },
        "value": {
          "type": "number"
        },
        "radius_m": {
          "default": 60,
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "pos",
        "value",
        "radius_m"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Catalogue": {
      "additionalProperties": false,
      "properties": {
        "drones": {
