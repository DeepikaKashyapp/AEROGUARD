{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contracts",
  "type": "object",
  "properties": {
    "Catalogue": {
      "$ref": "#/$defs/Catalogue"
    },
    "Scenario": {
      "$ref": "#/$defs/Scenario"
    },
    "SessionResult": {
      "$ref": "#/$defs/SessionResult"
    },
    "SimEvent": {
      "$ref": "#/$defs/SimEvent"
    },
    "TruthEntity": {
      "$ref": "#/$defs/TruthEntity"
    },
    "Replay": {
      "$ref": "#/$defs/Replay"
    }
  },
  "additionalProperties": false,
  "$defs": {
