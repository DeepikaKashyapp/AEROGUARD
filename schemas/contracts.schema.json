        "iff": {
          "default": false,
          "type": "boolean"
        },
        "cost_inr": {
          "type": "integer"
        },
        "damage": {
          "default": 0,
          "type": "number"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
