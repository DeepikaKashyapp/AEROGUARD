          "propertyNames": {
            "$ref": "#/$defs/DroneClass"
          },
          "type": "object"
        },
        "effectors": {
          "additionalProperties": {
            "$ref": "#/$defs/EffectorSpec"
          },
          "type": "object"
        },
        "sensors": {
          "additionalProperties": {
            "$ref": "#/$defs/SensorSpec"
          },
          "type": "object"
        },
        "effect_matrix": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "$ref": "#/$defs/DroneClass"
