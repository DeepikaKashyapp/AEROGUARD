    "EventType": {
      "enum": [
        "session_start",
        "session_end",
        "track_new",
        "track_lost",
        "track_regained",
        "hook",
        "classify",
        "ai_suggestion",
        "decision",
        "authority_request",
        "authority_granted",
        "engage_order",
        "engage_blocked",
        "engage_result",
        "cease",
        "neutralised",
        "link_lost",
        "diverted",
        "leaker",
        "exited",
        "expended",
        "recon_complete",
        "collateral",
        "friendly_affected",
        "sensor_state",
        "camera",
        "camera_designate",
        "pause",
        "resume"
