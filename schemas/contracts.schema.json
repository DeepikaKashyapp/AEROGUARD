      "required": [
        "name",
        "kind",
        "kill",
        "range_m",
        "cost_inr",
        "ammo",
        "rounds_per_shot",
        "sector_half_deg",
        "duration_s",
        "exposure_s",
        "dwell_s",
        "slew_s",
        "speed_mps",
        "blast_m",
        "pk",
        "cycle_s",
        "needs_los",
        "source",
        "illustrative"
      ],
      "title": "EffectorSpec",
      "type": "object"
    },
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "time_of_day": {
          "$ref": "#/$defs/TimeOfDay"
